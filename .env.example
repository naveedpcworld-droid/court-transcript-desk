# Optional. If unset, the pipeline uses yt-dlp / YouTube page metadata.
YOUTUBE_API_KEY=
# Optional future LLM classification; the MVP is deterministic and does not need it.
OPENAI_API_KEY=
# Set to 1 only if you have a rights-cleared workflow for ASR.
ENABLE_ASR=0
# Recommended for GitHub-hosted runners: YouTube blocks many datacenter IPs.
# Get a key at https://supadata.ai and add it as a GitHub Secret.
SUPADATA_API_KEY=
